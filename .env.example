# ============================================================================
# GeneSilico EHR — local environment
#
# NON-PRODUCTION ONLY. These are Ontada Developer Program sandbox values.
# Copy this file to .env and fill in the blanks. Do not put real values here.
# and never copy these values into a production .env.
#
# Anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle and is
# readable by anyone who opens the site. Secrets must NOT use that prefix.
# ============================================================================

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
PORT=3045
NEXT_PUBLIC_APP_ENV=sandbox

# ---------------------------------------------------------------------------
# Ontada (iKnowMed) — FHIR R4 gateway, non-prod sandbox
# Issued by the Ontada Developer Program (McKesson).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ONTADA_FHIR_BASE_URL=https://interopio.ontada.com/gateway/fhir/developerportalio/portal/gw-fhir
NEXT_PUBLIC_ONTADA_CLIENT_ID=
NEXT_PUBLIC_ONTADA_ENVIRONMENT=non-prod

# Server-side only. Not yet issued for this app registration — request it from
# DeveloperProgramMessaging@OntadaTech.McKesson.com if the SMART launch needs a
# confidential client.
ONTADA_CLIENT_SECRET=

# Must match the redirect URI registered in the Ontada developer portal exactly,
# or the SMART on FHIR launch is rejected.
ONTADA_REDIRECT_URI=http://localhost:3045/api/ontada/callback

# ---------------------------------------------------------------------------
# Ontada sandbox test accounts
# Used for standalone app launch and the iKM Simulator. Server-side only —
# these must never reach the browser bundle.
# ---------------------------------------------------------------------------
ONTADA_TEST_PRACTITIONER_USER=practitioner-aakash@genesilico.ai
ONTADA_TEST_PRACTITIONER_PASSWORD=

ONTADA_TEST_PATIENT_USER=patient-aakash@genesilico.ai
ONTADA_TEST_PATIENT_PASSWORD=

# ---------------------------------------------------------------------------
# GeneSilico services this module will talk to in the backend pass.
# Left blank on purpose — the UI runs entirely on fixtures today.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_AUTH_BASE_URL=
NEXT_PUBLIC_CASEBOOK_BASE_URL=
